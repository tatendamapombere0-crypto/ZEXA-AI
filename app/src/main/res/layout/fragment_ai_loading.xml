<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_auth_gradient"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoContainerLoading"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/accent_cyan"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivLogoLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo_zexa_mono"
            android:scaleType="centerCrop"
            android:contentDescription="ZEXA AI Logo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvLoadingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Initializing..."
        android:textColor="@color/accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Loading Message -->
    <TextView
        android:id="@+id/tvLoadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Optimizing Offline Intelligence"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvLoadingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please wait while we initialize your\nprivate academic environment."
        android:textSize="14sp"
        android:textColor="@color/primary_light"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />


    <!-- Progress Percentage -->
    <TextView
        android:id="@+id/tvProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="0%"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/accent_cyan"
        android:visibility="gone" />

</LinearLayout>
