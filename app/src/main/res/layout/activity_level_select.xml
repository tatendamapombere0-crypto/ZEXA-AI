<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/selection_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoContainer"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:cardCornerRadius="75dp"
        app:cardElevation="12dp"
        app:strokeWidth="3dp"
        app:strokeColor="@color/accent_cyan"
        android:layout_marginTop="48dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logo_zexa_mono"
            android:scaleType="centerCrop"
            android:contentDescription="ZEXA AI Logo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ZEXA AI"
        android:textColor="@color/primary_dark"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Zimbabwe's Premium Offline Tutor"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutMainSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_gravity="center"
            android:text="Select Education Category"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Primary Education"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            app:backgroundTint="@color/level_primary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:elevation="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Secondary Education"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            app:backgroundTint="@color/level_secondary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:elevation="4dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTertiary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Tertiary Education"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            app:backgroundTint="@color/level_tertiary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:elevation="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSecondarySelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_gravity="center"
            android:text="Select Secondary Level"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOLevel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="O-Level"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            app:backgroundTint="@color/level_secondary"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnALevel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="A-Level"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:textAllCaps="false"
            app:backgroundTint="@color/level_tertiary"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Back to categories"
            android:textAllCaps="false"
            android:textColor="@color/primary_dark" />
    </LinearLayout>

</LinearLayout>
