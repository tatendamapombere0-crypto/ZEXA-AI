<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- USER MESSAGE CONTAINER -->
    <LinearLayout
        android:id="@+id/container_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_bubble_user"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_message_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textIsSelectable="true"
            tools:text="Hello Zexa, how are you today?" />
    </LinearLayout>

    <!-- AI MESSAGE CONTAINER -->
    <LinearLayout
        android:id="@+id/container_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_bubble_ai"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_message_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textIsSelectable="true"
            tools:text="I am doing great! Ready to help you with your studies offline." />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
