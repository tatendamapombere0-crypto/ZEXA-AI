<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- USER MESSAGE -->
    <TextView
        android:id="@+id/tvUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_user"
        android:maxWidth="280dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textIsSelectable="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- AI MESSAGE VIEWS (FLATTENED) -->
    <TextView
        android:id="@+id/tvAIModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZEXA"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/accent_cyan"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAIMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_ai"
        android:maxWidth="300dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.2"
        android:textIsSelectable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAIModel" />

    <ImageButton
        android:id="@+id/btnCopyAI"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_check"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        app:tint="@color/accent_cyan"
        android:alpha="0.6"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvAIMessage"
        app:layout_constraintEnd_toEndOf="@id/tvAIMessage"
        android:layout_margin="4dp" />

    <TextView
        android:id="@+id/tvMetrics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="@color/accent_cyan"
        android:alpha="0.7"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAIMessage" />

    <!-- THINKING INDICATOR (FLATTENED) -->
    <View
        android:id="@+id/viewThinkingBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_bubble_ai"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/progressThinking"
        app:layout_constraintBottom_toBottomOf="@id/progressThinking"
        app:layout_constraintStart_toStartOf="@id/progressThinking"
        app:layout_constraintEnd_toEndOf="@id/tvThinking"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="-8dp"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp" />

    <ProgressBar
        android:id="@+id/progressThinking"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:indeterminate="true"
        style="?android:attr/progressBarStyleSmall"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="28dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvThinking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZEXA IS THINKING..."
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent_cyan"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/progressThinking"
        app:layout_constraintTop_toTopOf="@id/progressThinking"
        app:layout_constraintBottom_toBottomOf="@id/progressThinking"
        android:layout_marginStart="8dp" />

    <!-- GROUPS FOR VISIBILITY (Zero-nesting layers) -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutAI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tvAIModel,tvAIMessage,tvMetrics" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/layoutThinking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="viewThinkingBg,progressThinking,tvThinking" />

</androidx.constraintlayout.widget.ConstraintLayout>
