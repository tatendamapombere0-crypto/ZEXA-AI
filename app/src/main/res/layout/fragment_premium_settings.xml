<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/containerPremiumContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card_hitech"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvPremiumTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACTIVATE PREMIUM"
                android:textColor="@color/accent_cyan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvPremiumPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="$5.00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="@color/primary_blue"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="To activate Premium, obtain an Activation Code by paying via EcoCash to our Merchant:\n0783596818\n\nOnce paid, WhatsApp your confirmation screenshot to 0717713396 to receive your unique Activation Code. Enter it below to unlock unlimited access."
                android:textColor="@color/white"
                android:alpha="0.9"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:gravity="center" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilActivationCode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textColorHint="@color/white"
                app:hintTextColor="@color/accent_cyan"
                app:boxStrokeColor="@color/accent_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etActivationCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Action Code"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpgradePremium"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="ACTIVATE PREMIUM NOW"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/accent_cyan"
                android:textColor="@color/primary_dark" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ZEXA OFFLINE ACTIVATION SYSTEM"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:gravity="center"
            android:letterSpacing="0.2" />

        <!-- Hidden containers to avoid breaking existing binding references -->
        <LinearLayout android:id="@+id/containerInstructions" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:orientation="vertical" />
        <EditText android:id="@+id/etPhoneNumber" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tilPhoneNumber" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseDialog" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvInstructionTitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvInstructionSteps" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvInstructionPhone" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvInstructionAmount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvInstructionReference" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvPollingStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>
</ScrollView>
