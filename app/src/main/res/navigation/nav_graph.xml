<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/aiLoadingFragment">

    <fragment
        android:id="@+id/aiLoadingFragment"
        android:name="com.zexa.aioffline.ui.fragments.AILoadingFragment"
        android:label="AI Loading"
        tools:layout="@layout/fragment_ai_loading">
        <action
            android:id="@+id/action_aiLoading_to_chat"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/aiLoadingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.zexa.aioffline.ui.fragments.ChatFragment"
        android:label="ZEXA AI Chat"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/subjectsFragment"
        android:name="com.zexa.aioffline.ui.fragments.SubjectsFragment"
        android:label="Subjects"
        tools:layout="@layout/fragment_subjects" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.zexa.aioffline.ui.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/premiumSettingsFragment"
        android:name="com.zexa.aioffline.ui.fragments.PremiumSettingsFragment"
        android:label="Premium Settings"
        tools:layout="@layout/fragment_premium_settings" />
</navigation>
