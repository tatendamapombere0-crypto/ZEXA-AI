<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.zexa.aioffline">

    <uses-sdk tools:overrideLibrary="com.google.mediapipe.tasks.genai, com.google.ai.client.generativeai, com.google.firebase.auth, com.google.firebase.firebase_auth, androidx.browser, com.google.mediapipe.tasks.core" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.zexa.ai.zimsec.ZEXAApplication"
        android:allowBackup="true"
        android:icon="@mipmap/logo_zexa_mono"
        android:label="ZEXA AI"
        android:roundIcon="@mipmap/logo_zexa_mono_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:vmSafeMode="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ZexaAI">

        <activity
            android:name=".ui.AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.ZexaAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LevelSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.ZexaAI" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ZexaAI" />

        <activity
            android:name=".ui.ModelSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.ZexaAI" />

        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ZexaAI" />

        <activity
            android:name=".ui.PaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.ZexaAI" />
    </application>

</manifest>
